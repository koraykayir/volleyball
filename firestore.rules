rules_version = '2';
// Security rules for the volleyball sign-up page.
// Paste into Firebase console > Firestore Database > Rules > Publish.
// Organizers: add a document to the `admins` collection whose ID is the organizer's Google email (lowercase).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function email() { return request.auth.token.get('email', ''); }
    function isAdmin() {
      return signedIn() && email() != '' && request.auth.token.get('email_verified', false) == true
        && exists(/databases/$(database)/documents/admins/$(email()));
    }
    function sessionData(id) { return get(/databases/$(database)/documents/sessions/$(id)).data; }
    function sessionOpen(id) {
      let s = sessionData(id);
      return s.status == 'open' && (s.get('opensAtTs', null) == null || request.time >= s.opensAtTs);
    }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 60 && !n.matches('.*/.*'); }
    // The key of a name claim (names/{key}) is computed by the page (nameKey(): lowercase and accent-insensitive,
    // so a name typed with or without Turkish letters is the same name) and stored in the profile as nameKey.
    // The rules engine does not lowercase non-ASCII letters (the C with cedilla, O/U with umlaut, dotted I...),
    // so the key is checked strictly only for plain-ASCII names; for other names it must be lowercase-shaped
    // and consistent between the profile and the claim.
    function asciiOnly(s) { return s.matches('[ -~]*'); }
    function keyFits(key, name) {
      return key is string && key.size() > 0 && key == key.lower() && (!asciiOnly(name) || key == name.lower());
    }
    // Profiles written by earlier builds have no nameKey yet: then the claim key is the lowercased name, as before.
    function profileKey(uid) { return profileAfter(uid).get('nameKey', profileAfter(uid).name.lower()); }
    // Leaving without an organizer: only in the last 3 hours before the start (or later). The start is
    // stored by the organizer as startsAtTs; without it nobody can leave on their own.
    function leaveIsFree(id) {
      let s = sessionData(id);
      return s.get('startsAtTs', null) != null && request.time >= s.startsAtTs - duration.value(3, 'h');
    }

    // Organizer list: maintained by hand in the console. Each person may only check their own entry.
    match /admins/{adminEmail} {
      allow read: if signedIn() && email() == adminEmail;
      allow write: if false;
    }

    // Group settings, sessions: public to read, organizers write.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sessions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Clock check: each logged-in person writes a server timestamp here and reads it back,
    // to show countdowns in server time. Private to that person.
    match /clock/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
    }

    function profileAfter(uid) { return getAfter(/databases/$(database)/documents/players/$(uid)).data; }

    // Claimed display names, one per account: makes names unique across the group.
    // A claim can only be created (never overwritten), and must match the owner's profile name in the
    // same write, so two people cannot end up with the same name. Renaming deletes the old claim.
    match /names/{key} {
      // A single claim may be looked up by anyone, so the sign-up form can say "name taken" before the
      // account is created (the person is not logged in yet at that point). Listing stays organizer-only.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.name)
        && request.resource.data.name == profileAfter(request.auth.uid).name
        && key == profileKey(request.auth.uid)
        && keyFits(key, request.resource.data.name);
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/players/$(request.auth.uid))
          || profileKey(request.auth.uid) != key));
    }

    // Player profiles: created once by the player with a level of 1 to 5 (together with their name claim).
    // The player may rename themselves (the new name must be claimed in the same write); only the organizer changes the level.
    match /players/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'level', 'email', 'createdAt', 'nameKey'])
        && validName(request.resource.data.name)
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 5
        && request.resource.data.email == email()
        && request.resource.data.createdAt == request.time
        && (!('nameKey' in request.resource.data) || keyFits(request.resource.data.nameKey, request.resource.data.name));
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['level', 'name'])
          && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 5
          && validName(request.resource.data.name))
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameKey'])
          && validName(request.resource.data.name)
          && (!('nameKey' in request.resource.data) || keyFits(request.resource.data.nameKey, request.resource.data.name))
          && getAfter(/databases/$(database)/documents/names/$(profileKey(uid))).data.uid == uid);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Skill ratings for people the organizer added by hand, and team pairs: organizers only.
    match /ratings/{doc} {
      allow read, write: if isAdmin();
    }

    // Emails of people the organizer added by hand: organizers only.
    match /contacts/{signupId} {
      allow read, write: if isAdmin();
    }

    // Sign-ups: anyone can read the list. A logged-in player with a profile adds themselves
    // (one entry per session, ID = sessionId_uid) while the session is open. Leaving is immediate in the
    // last 3 hours before the start; before that it is a request ('leaving') that an organizer confirms.
    // A player can take a request back and can rejoin at the back of the queue. Organizers can change anything.
    match /signups/{id} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn()
        && id == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['sessionId', 'name', 'uid', 'createdAt', 'status', 'paid', 'noshow', 'guestOf', 'addedBy'])
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && validName(request.resource.data.name)
        && request.resource.data.name == profileAfter(request.auth.uid).name
        && request.resource.data.status == 'active'
        && request.resource.data.paid == false && request.resource.data.noshow == false
        && request.resource.data.guestOf == '' && request.resource.data.addedBy == 'self'
        && request.resource.data.createdAt == request.time
        && sessionOpen(request.resource.data.sessionId));
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid && resource.data.addedBy == 'self'
        && (
          // rename (the profile carries the same new name in this write)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name == profileAfter(request.auth.uid).name)
          ||
          // leave right away (last 3 hours before the start)
          (resource.data.status == 'active'
            && sessionData(resource.data.sessionId).status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'leftAt'])
            && request.resource.data.status == 'left' && request.resource.data.leftAt == request.time
            && leaveIsFree(resource.data.sessionId))
          ||
          // ask to leave (an organizer decides)
          (resource.data.status == 'active'
            && sessionData(resource.data.sessionId).status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'leaveRequestedAt'])
            && request.resource.data.status == 'leaving' && request.resource.data.leaveRequestedAt == request.time)
          ||
          // "I've paid" note (set or taken back); only the organizer marks paid
          ((resource.data.status == 'active' || resource.data.status == 'leaving')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidClaimedAt'])
            && (!('paidClaimedAt' in request.resource.data) || request.resource.data.paidClaimedAt == request.time))
          ||
          // take the request back
          (resource.data.status == 'leaving'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'active')
          ||
          // rejoin: goes to the back of the queue
          (resource.data.status == 'left'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'createdAt', 'name'])
            && request.resource.data.status == 'active' && request.resource.data.createdAt == request.time
            && request.resource.data.name == profileAfter(request.auth.uid).name
            && sessionOpen(resource.data.sessionId))
        ));
      allow delete: if isAdmin();
    }

    // Activity log: every join, leave and change, written in the same batch as the change itself.
    // Organizers read it. A player may only log things about themselves, and only when the same
    // write really made that change (checked against the state after the batch).
    match /log/{id} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['sessionId', 'at', 'type', 'name', 'uid', 'key', 'detail', 'by', 'byName'])
        && request.resource.data.at == request.time
        && request.resource.data.by == request.auth.uid
        && (isAdmin() || (request.resource.data.uid == request.auth.uid && selfLogOk(request.resource.data)));
    }
    function signupAfter(sid) { return getAfter(/databases/$(database)/documents/signups/$(sid + '_' + request.auth.uid)).data; }
    function selfLogOk(e) {
      return (e.type in ['join', 'rejoin'] && signupAfter(e.sessionId).status == 'active')
        || (e.type == 'leave' && signupAfter(e.sessionId).status == 'left')
        || (e.type == 'leave-request' && signupAfter(e.sessionId).status == 'leaving')
        || (e.type == 'leave-cancel' && signupAfter(e.sessionId).status == 'active')
        || (e.type == 'paid-claim' && 'paidClaimedAt' in signupAfter(e.sessionId))
        || (e.type == 'paid-unclaim' && !('paidClaimedAt' in signupAfter(e.sessionId)))
        || (e.type in ['register', 'rename'] && profileAfter(request.auth.uid).name == e.name)
        || (e.type == 'account-delete' && !existsAfter(/databases/$(database)/documents/players/$(request.auth.uid)));
    }
  }
}
